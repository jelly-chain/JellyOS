# ════════════════════════════════════════════════════════════════
#  JellyOS Environment Variables
#  Copy to .env (same directory) and fill in your keys:
#    cp .env.example .env
#    nano .env
#
#  Or run the setup wizard:
#    jelly setup
# ════════════════════════════════════════════════════════════════

# ── Required ──────────────────────────────────────────────────
# OpenRouter API key (gives access to 100+ LLMs via one key)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Blockchain Data ───────────────────────────────────────────
# Alchemy API key for 16 EVM chains (balances, transactions, gas)
# Free tier: https://www.alchemy.com/
ALCHEMY_KEY=

# ── Prediction Markets ────────────────────────────────────────
# Polymarket CLOB API key (for trading, not just reading)
POLYMARKET_API_KEY=
POLYMARKET_PRIVATE_KEY=

# Kalshi API key
KALSHI_API_KEY=
KALSHI_PRIVATE_KEY=

# Manifold Markets API key (free)
MANIFOLD_API_KEY=

# ── Model Selection ───────────────────────────────────────────
# Default OpenRouter model IDs (format: provider/model-name)
JELLY_MODEL_1=anthropic/claude-sonnet-4-5
JELLY_MODEL_2=openai/gpt-4o-mini
JELLY_MODEL_3=google/gemini-2.5-pro
JELLY_MODEL_4=meta-llama/llama-4-maverick
JELLY_MODEL_5=deepseek/deepseek-chat

# ── Agent Configuration ───────────────────────────────────────
# Effect level: eco | normal | turbo | max
JELLY_EFFECT_LEVEL=normal

# Max sub-agents in swarm mode (turbo/max)
JELLY_MAX_AGENTS=5

# Dashboard WebSocket port
JELLY_DASHBOARD_PORT=4320

# Dashboard authentication token (optional but recommended)
JELLY_DASHBOARD_TOKEN=

# Auto-vault sweep threshold in USD (sweep profits above this amount)
AUTO_VAULT_THRESHOLD=500

# ── Optional External APIs ────────────────────────────────────
# CoinGecko Pro API key (free tier works without this)
COINGECKO_API_KEY=

# Coinglass API key (for detailed funding rate data)
COINGLASS_API_KEY=

# Twitter/X Bearer token (for social sentiment)
TWITTER_BEARER_TOKEN=

# ── Messaging Bridges ─────────────────────────────────────────
# Telegram: create a bot at https://t.me/BotFather, then get your chat ID
# from https://t.me/userinfobot after sending it a message
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord: create a bot at https://discord.com/developers/applications
# Enable "Message Content Intent" and invite bot to your server
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# ── TradingView Webhook ────────────────────────────────────────
# Local port for receiving TradingView alerts (default 9340)
# In TradingView alert: URL = http://127.0.0.1:9340/webhook
# Body: { "ticker": "{{ticker}}", "action": "buy", "price": {{close}} }
JELLY_WEBHOOK_PORT=9340
