{
  "name": "@jellyos/agent",
  "version": "0.2.1",
  "description": "JellyOS — standalone AI trading agent. Runs locally, no server required.",
  "author": [
    "JellyOS Team",
    "Auther Bsc Admin"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/Index.js",
  "types": "./dist/Index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/Index.js",
      "types": "./dist/Index.d.ts"
    }
  },
  "bin": {
    "jellyos": "./bin/jellyagent",
    "jellyagent": "./bin/jellyagent",
    "jellyos-mcp": "./bin/jellyos-mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npx tsc",
    "build:watch": "tsc --watch",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src/ skills/ extensions/ --ext .ts,.mts",
    "lint:fix": "eslint src/ skills/ extensions/ --ext .ts,.mts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"skills/**/*.ts\" \"extensions/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"skills/**/*.ts\" \"extensions/**/*.ts\"",
    "validate:skills": "tsx scripts/validate-skills.ts"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.32.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "chalk": "^5.3.0",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.1",
    "ink": "^5.0.1",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/react": "^18.3.29",
    "argon2": "^0.44.0",
    "ethers": "^6.16.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "ai",
    "agent",
    "trading",
    "blockchain",
    "terminal",
    "cli",
    "jellyos"
  ]
}
